    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^20.14.10",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^9.23.0",
    "eslint-config-next": "^15.2.3",
    "happy-dom": "^20.9.0",
    "jsdom": "^29.0.2",
    "msw": "^2.13.3",
    "postcss": "^8.5.3",
    "prettier": "^3.5.3",
